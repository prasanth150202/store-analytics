Options -Indexes
DirectoryIndex index.html

# Every /api/* request goes to one PHP entry point; /health is a plain "is it up" check.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/api/index\.php$
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]
    RewriteRule ^health$ api/index.php [L]
</IfModule>

# Credentials and notes are never served.
<FilesMatch "^(config.*\.php|.*\.md|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # Scripts and styles change with each release: always re-check with the server (it answers 304 when unchanged).
    <FilesMatch "\.(js|css|html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "same-origin"
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
